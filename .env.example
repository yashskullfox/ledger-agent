# FinancialIntelligence – Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env && ./run.sh
#   # OR use python-dotenv (auto-loaded if installed):
#   #   pip install python-dotenv
#   #   The app auto-loads .env when python-dotenv is present

# ── Paths (optional overrides) ────────────────────────────────────────────────
# FI_DATA_DIR=/absolute/path/to/data          # Override data directory
# FI_DB_PATH=/absolute/path/to/financials.db  # Override database path
# FI_MEMORY_FILE=/path/to/memory.json         # Override classification memory
# FI_STATEMENTS_DIR=/absolute/path/to/statements  # Override statements folder (used by scan/onboard)
# FI_STATEMENT_GLOB=*.pdf                          # Glob pattern for statement discovery (default *.pdf)

# ── Entity defaults (pre-fill wizard, optional) ───────────────────────────────
# FI_DEFAULT_ENTITY_NAME=MY COMPANY LLC
# FI_DEFAULT_ENTITY_STATE=CA
# FI_DEFAULT_ENTITY_TYPE=LLC

# ── AI Backend ────────────────────────────────────────────────────────────────
# Choose one: local, openai, gemini, anthropic, openai_compatible, ollama
# Unknown values log a warning and fall back to local.
FI_AI_BACKEND=local

# OpenAI  (key required when FI_AI_BACKEND=openai)
# FI_OPENAI_API_KEY=sk-...your-key-here...
# FI_OPENAI_MODEL=gpt-4o-mini
# FI_OPENAI_BASE_URL=                 # optional endpoint override (proxy / gateway)

# OpenAI-compatible endpoint (FI_AI_BACKEND=openai_compatible, or ollama)
#   Uses the OpenAI SDK against FI_OPENAI_BASE_URL; API key optional.
#   Data is still redacted before it is sent, even to localhost.
# FI_OPENAI_BASE_URL=http://localhost:11434/v1   # default for ollama
# FI_OPENAI_MODEL=llama3.1                       # any model the endpoint serves
# FI_OPENAI_API_KEY=                             # only if the endpoint requires one

# Google Gemini  (key required when FI_AI_BACKEND=gemini)
# FI_GEMINI_API_KEY=AIza...your-key-here...
# FI_GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude  (key required when FI_AI_BACKEND=anthropic; ANTHROPIC_API_KEY also accepted)
# FI_ANTHROPIC_API_KEY=...your-key-here...
# FI_ANTHROPIC_MODEL=claude-haiku-5-5
# FI_ANTHROPIC_EFFORT=low             # low | medium | high | none (omit; for older models)

# ── Classification tuning ─────────────────────────────────────────────────────
# FI_AUTO_CLASSIFY_THRESHOLD=85         # 0-100, fuzzy match score for auto-classify
# FI_LOCAL_CONFIDENCE_THRESHOLD=0.65   # 0.0-1.0, below this local escalates to remote AI

# ── Logging ───────────────────────────────────────────────────────────────────
FI_LOG_LEVEL=INFO
# FI_LOG_FORMAT=rich               # Options: rich (default) | json | plain

# ── Accounting ────────────────────────────────────────────────────────────────
# FI_FISCAL_YEAR_START_MM=1        # 1=January (default)

# ── Tax rates (adjust to match your actual tax situation) ─────────────────────
# All rates are decimals (e.g. 0.048 = 4.8%).  Defaults shown.                           # redaction: allow
# FI_STATE_TAX_RATE=0.05           # Entity-level state PTET rate (estimate = rate x entity taxable income)  # redaction: allow
# FI_LOCAL_CONFIDENCE_THRESHOLD=0.75  # Min AI confidence to auto-apply classification (0.0–1.0)

# ── Privacy / PII Egress Firewall ─────────────────────────────────────────────
# FI_AI_EGRESS_MODE=redact         # Options: redact (default) | strict | mock | passthrough
# FI_AI_EGRESS_MODE_ACK=           # Set to I_understand_the_risk when mode=passthrough
